            "property_iri": "https://w3id.org/smn/Abundance",
            "entity_iri": "https://w3id.org/smn/Stock"
          },
          {
            "name": "estimate_method",
            "title": "Estimate method",
            "type": "string",
            "description": "Row-varying recruit estimation procedure",
            "constraints": {
              "required": true
            },
            "term_type": "skos_concept"
          }
